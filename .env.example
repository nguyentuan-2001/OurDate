# Our Date — biến môi trường mẫu.
# Sao chép file này thành ".env" và điền giá trị thật. KHÔNG commit file ".env".
#
# Biến có tiền tố EXPO_PUBLIC_ sẽ được đóng gói vào app client (Android/iOS),
# vì vậy chỉ đặt publishable/anon key ở đây — không đặt secret key hoặc service role key.

# --- Supabase (cần từ Milestone 2) ---
# Lấy tại: Supabase Dashboard > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=

# --- Google Maps Platform (cần từ Milestone 4/5) ---
# KHÔNG đặt Google server-side API key ở đây. Key cần được giới hạn theo API/domain
# và gọi qua Supabase Edge Function, không gọi trực tiếp từ app client.
# Biến dưới đây chỉ dùng ở môi trường server/Edge Function, không có tiền tố EXPO_PUBLIC_.
GOOGLE_MAPS_SERVER_API_KEY=

# --- AI provider (cần từ Milestone 6) ---
# Chọn provider và đặt secret key ở môi trường server/Edge Function, không ở client.
AI_PROVIDER=
AI_API_KEY=
